generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  label       String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id              Int        @id @default(autoincrement())
  name            String     @db.VarChar(100)
  username        String     @unique @db.VarChar(50)
  email           String     @unique @db.VarChar(150)
  password       String     @db.VarChar(255)
  phone          String?    @db.VarChar(30)
  gender         String?    @db.VarChar(20)
  dob            DateTime?
  address        String?    @db.Text
  roleId         Int
  isActive       Boolean    @default(true)
  isFounder      Boolean    @default(false)
  resetToken     String?    @db.VarChar(255)
  resetTokenExpiry DateTime?
  createdAt     DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime? 
  role           Role       @relation(fields: [roleId], references: [id])
  stockLogs StockLog[]
  orders    Order[]    @relation("OrderCreatedBy")
  sales     Sale[]     @relation("SaleCreatedBy")
  expenses  Expense[]  @relation("ExpenseCreatedBy")
  deleteRequestsMade     DeleteRequest[] @relation("DeleteRequestedBy")
  deleteRequestsReviewed DeleteRequest[] @relation("DeleteReviewedBy")
  activityLogs           ActivityLog[]
  posSessions            PosSession[]
  heldOrders             HeldOrder[]
  notifications          Notification[]
  notificationReads      NotificationRead[]
  businessMemberships    BusinessMember[]
  reviewedRegistrations  RegistrationRequest[]
  passwordResetTokens    PasswordResetToken[]
  lastLoginAt           DateTime?
  lastLoginIp           String?    @db.VarChar(45)
  emailVerifiedAt       DateTime?
  subscriptionRequests  SubscriptionRequest[]
  requestNotes          RequestNote[]
  emailVerificationTokens EmailVerificationToken[]
}

model Notification {
  id         Int                @id @default(autoincrement())
  businessId Int
  userId     Int?
  type       String             @db.VarChar(50)
  title      String             @db.VarChar(255)
  message    String             @db.Text
  isRead     Boolean            @default(false)
  link       String?            @db.VarChar(500)
  createdAt  DateTime           @default(now())
  user       User?              @relation(fields: [userId], references: [id])
  reads      NotificationRead[]
}

model NotificationRead {
  id             Int          @id @default(autoincrement())
  businessId     Int
  notificationId Int
  userId         Int
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  @@unique([notificationId, userId])
}

model PosSession {
  id            String   @id
  shortId       String   @unique @db.VarChar(20)
  businessId    Int
  createdBy     Int
  status        String   @default("active")
  scans         String?  @db.Text
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  createdByUser User     @relation(fields: [createdBy], references: [id])
}

model HeldOrder {
  id            Int      @id @default(autoincrement())
  businessId    Int
  createdBy     Int
  items         String   @db.Text
  customerData  String?  @db.Text
  discount      Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  createdByUser User     @relation(fields: [createdBy], references: [id])
}

model Category {
  id         Int       @id @default(autoincrement())
  businessId Int
  name       String    @db.VarChar(100)
  createdAt  DateTime  @default(now())
  products   Product[]
  @@unique([businessId, name])
}

model Product {
  id          Int        @id @default(autoincrement())
  productId   String     @unique @db.VarChar(20)
  businessId  Int
  name        String     @db.VarChar(255)
  sku         String?    @db.VarChar(100)
  categoryId  Int?
  unit        String     @db.VarChar(50)
  salePrice   Decimal    @db.Decimal(10, 2)
  costPrice   Decimal    @db.Decimal(10, 2)
  taxRate     Decimal    @default(0) @db.Decimal(5, 2)
  description String?    @db.Text
  imageUrl    String?    @db.VarChar(500)
  status      String     @default("active") @db.VarChar(20)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  category    Category?  @relation(fields: [categoryId], references: [id])
  stock       Stock?
  stockLogs   StockLog[]
  orderItems  OrderItem[]
  sales       Sale[]
  variants    ProductVariant[]
}

model ProductVariant {
  id                Int       @id @default(autoincrement())
  businessId        Int
  productId         Int
  label             String    @db.VarChar(255)
  optionSignature   String    @db.VarChar(255)
  sku               String?   @db.VarChar(100)
  barcode           String?   @db.VarChar(100)
  stockQuantity     Int       @default(0)
  lowStockThreshold Int       @default(10)
  location          String?   @db.VarChar(255)
  salePriceOverride Decimal?  @db.Decimal(10, 2)
  costPriceOverride Decimal?  @db.Decimal(10, 2)
  status            String    @default("active") @db.VarChar(20)
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  product           Product   @relation(fields: [productId], references: [id])
  stockLogs         StockLog[]
  orderItems        OrderItem[]
  sales             Sale[]

  @@unique([productId, optionSignature])
  @@unique([businessId, sku])
  @@unique([businessId, barcode])
  @@index([businessId, productId])
  @@index([businessId, status])
}

model Stock {
  id         Int        @id @default(autoincrement())
  businessId Int
  productId  Int        @unique
  quantity   Int        @default(0)
  threshold  Int        @default(10)
  location   String?    @db.VarChar(255)
  updatedAt  DateTime   @updatedAt
  product    Product    @relation(fields: [productId], references: [id])
  stockLogs  StockLog[]
}

model StockLog {
  id            Int      @id @default(autoincrement())
  businessId    Int
  stockId       Int
  productId     Int
  productVariantId Int?
  type          String   @db.VarChar(20)
  quantity      Int
  reason        String?  @db.VarChar(255)
  previousQty   Int
  newQty        Int
  createdBy     Int
  createdAt     DateTime @default(now())
  stock         Stock    @relation(fields: [stockId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  createdByUser User     @relation(fields: [createdBy], references: [id])

  @@index([productVariantId])
}

model DeleteRequest {
  id          Int       @id @default(autoincrement())
  businessId  Int
  entityType  String    @db.VarChar(50)
  entityId    String    @db.VarChar(50)
  entityName  String    @db.VarChar(255)
  reason      String    @db.Text
  status      String    @default("pending") @db.VarChar(20)
  requestedBy Int
  reviewedBy  Int?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  requester   User      @relation("DeleteRequestedBy", fields: [requestedBy], references: [id])
  reviewer    User?     @relation("DeleteReviewedBy", fields: [reviewedBy], references: [id])
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  businessId  Int
  userId      Int
  action      String   @db.VarChar(50)
  module      String   @db.VarChar(50)
  entityId    String?  @db.VarChar(50)
  entityName  String?  @db.VarChar(255)
  description String   @db.Text
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(500)
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Customer {
  id              Int       @id @default(autoincrement())
  customerId      String    @unique @db.VarChar(20)
  businessId      Int
  name            String    @db.VarChar(150)
  email           String?   @db.VarChar(150)
  mobile          String    @db.VarChar(30)
  country         String?   @db.VarChar(100)
  state           String?   @db.VarChar(100)
  zipCode         String?   @db.VarChar(20)
  city            String?   @db.VarChar(100)
  streetAddress   String?   @db.Text
  billingAddress  String?   @db.Text
  shippingAddress String?   @db.Text
  status          String    @default("active") @db.VarChar(20)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  orders          Order[]
  sales           Sale[]
}

model Supplier {
  id              Int       @id @default(autoincrement())
  supplierId      String    @unique @db.VarChar(20)
  businessId      Int
  companyName     String    @db.VarChar(255)
  contactName    String    @db.VarChar(150)
  email          String?   @db.VarChar(150)
  mobile          String?   @db.VarChar(30)
  website        String?   @db.VarChar(255)
  taxId          String?   @db.VarChar(100)
  paymentTerms   String?   @db.VarChar(100)
  currency       String    @default("BDT") @db.VarChar(10)
  bankName       String?   @db.VarChar(150)
  bankAccount    String?   @db.VarChar(100)
  accountName   String?   @db.VarChar(150)
  branchName    String?   @db.VarChar(150)
  routingNumber String?   @db.VarChar(50)
  swiftCode     String?   @db.VarChar(50)
  bkash        String?   @db.VarChar(30)
  nagad         String?   @db.VarChar(30)
  rocket        String?   @db.VarChar(30)
  upay         String?   @db.VarChar(30)
  paymentMethods Json?
  category      String?   @db.VarChar(100)
  deliveryMethod String? @db.VarChar(100)
  streetAddress  String?   @db.Text
  city          String?   @db.VarChar(100)
  state         String?   @db.VarChar(100)
  zipCode       String?   @db.VarChar(20)
  country      String?   @db.VarChar(100)
  status        String    @default("active") @db.VarChar(20)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}

model Setting {
  id            Int      @id @default(autoincrement())
  businessId    Int
  businessName  String   @db.VarChar(150)
  tagline       String?  @db.VarChar(255)
  email         String?  @db.VarChar(150)
  phone         String?  @db.VarChar(30)
  website       String?  @db.VarChar(255)
  taxId         String?  @db.VarChar(100)
  address       String?  @db.Text
  city          String?  @db.VarChar(100)
  state         String?  @db.VarChar(100)
  zipCode       String?  @db.VarChar(20)
  country       String?  @db.VarChar(100)
  logoUrl            String?  @db.VarChar(500)
  printLogoUrl       String?  @db.VarChar(500)
  emailHeaderLogoUrl String?  @db.VarChar(500)
  brandColor         String?  @db.VarChar(20)
  invoiceFooter String?  @db.Text
  isSetupComplete Boolean  @default(false)
  currency      String   @default("BDT") @db.VarChar(10)
  weekStartDay  Int      @default(0)
  // SMTP Settings
  smtpProvider               String?  @db.VarChar(50)
  smtpHost                  String?  @db.VarChar(255)
  smtpPort                  Int?     @default(587)
  smtpUsername              String?  @db.VarChar(150)
  smtpPassword              String?  @db.VarChar(500)
  smtpEncryption            String?  @db.VarChar(10)
  smtpFromEmail             String?  @db.VarChar(150)
  smtpFromName              String?  @db.VarChar(100)
  smtpReplyTo               String?  @db.VarChar(150)
  supportEmail              String?  @db.VarChar(150)
  emailFooterText           String?  @db.Text
  companyAddressFooter      String?  @db.Text
  emailOrderConfirmationEnabled Boolean @default(true)
  emailInvoiceEnabled       Boolean  @default(true)
  emailPasswordResetEnabled  Boolean  @default(true)
  emailUserRegistrationEnabled Boolean @default(true)
  emailLowStockEnabled       Boolean  @default(true)
  emailDailySummaryEnabled   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([businessId])
}

model Order {
  id              Int         @id @default(autoincrement())
  orderId         String      @unique @db.VarChar(20)
  businessId      Int
  customerId      Int
  status          String      @default("pending") @db.VarChar(20)
  paymentStatus   String      @default("unpaid") @db.VarChar(20)
  paymentMethod   String?     @db.VarChar(50)
  subtotal        Decimal     @db.Decimal(10, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal     @db.Decimal(10, 2)
  paidAmount      Decimal     @default(0) @db.Decimal(10, 2)
  shippingAddress String?     @db.Text
  billingAddress  String?     @db.Text
  notes           String?     @db.Text
  createdBy       Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  customer        Customer    @relation(fields: [customerId], references: [id])
  createdByUser   User        @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  items           OrderItem[]
  sales           Sale[]
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  businessId  Int
  orderId     Int
  productId   Int
  productVariantId Int?
  productName String   @db.VarChar(255)
  variantLabel String? @db.VarChar(255)
  skuSnapshot String?  @db.VarChar(100)
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  order       Order    @relation(fields: [orderId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@index([productVariantId])
}

model Sale {
  id              Int       @id @default(autoincrement())
  saleId          String    @unique @db.VarChar(20)
  businessId      Int
  orderId         Int?
  customerId      Int?
  productId       Int?
  productVariantId Int?
  productName     String?   @db.VarChar(255)
  variantLabel    String?   @db.VarChar(255)
  skuSnapshot     String?   @db.VarChar(100)
  date            DateTime  @default(now())
  quantity        Int       @default(1)
  unitPrice       Decimal   @db.Decimal(10, 2)
  totalAmount     Decimal   @db.Decimal(10, 2)
  taxAmount       Decimal   @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal   @default(0) @db.Decimal(10, 2)
  paymentStatus   String    @default("unpaid") @db.VarChar(20)
  paymentMethod   String?   @db.VarChar(50)
  shippingAddress String?   @db.Text
  billingAddress  String?   @db.Text
  deliveryDate    DateTime?
  trackingNumber  String?   @db.VarChar(100)
  warrantyPeriod  String?   @db.VarChar(100)
  salesCommission Decimal   @default(0) @db.Decimal(10, 2)
  returnStatus    String    @default("none") @db.VarChar(20)
  notes           String?   @db.Text
  createdBy       Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  order           Order?    @relation(fields: [orderId], references: [id])
  customer        Customer? @relation(fields: [customerId], references: [id])
  product         Product?  @relation(fields: [productId], references: [id])
  productVariant  ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  createdByUser   User      @relation("SaleCreatedBy", fields: [createdBy], references: [id])

  @@index([productVariantId])
}

model Expense {
  id            Int       @id @default(autoincrement())
  expenseId     String    @unique @db.VarChar(20)
  businessId    Int
  date          DateTime  @default(now())
  amount        Decimal   @db.Decimal(10, 2)
  currency      String    @default("BDT") @db.VarChar(10)
  category      String    @db.VarChar(100)
  paymentMethod String    @db.VarChar(50)
  vendor        String    @db.VarChar(255)
  receiptId     String?   @db.VarChar(100)
  referenceNo   String?   @db.VarChar(100)
  taxAmount     Decimal   @default(0) @db.Decimal(10, 2)
  taxPercent    Decimal   @default(0) @db.Decimal(5, 2)
  description   String?   @db.Text
  notes         String?   @db.Text
  createdBy     Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdByUser User      @relation("ExpenseCreatedBy", fields: [createdBy], references: [id])
}

model Business {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   BusinessMember[]
  subscription Subscription?
  usages    Usage[]
  usageOverrides UsageOverride[]
  subscriptionRequests SubscriptionRequest[]
}

model BusinessMember {
  id         Int      @id @default(autoincrement())
  userId     Int
  businessId Int
  isDefault  Boolean  @default(false)
  status     String   @default("active") @db.VarChar(20)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId, status])
  @@index([businessId, status])
  @@index([userId, isDefault])
}

model ApiKey {
  id          Int       @id @default(autoincrement())
  businessId  Int
  name        String
  key         String    @unique
  isActive    Boolean   @default(true)
  permissions String    // JSON array: ["read:products", "write:orders"]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Webhook {
  id          Int       @id @default(autoincrement())
  businessId  Int
  name        String
  url         String
  secret      String
  events      String    // JSON: ["order.created", "stock.low"]
  isActive    Boolean   @default(true)
  lastFiredAt DateTime?
  failCount   Int       @default(0)
  createdAt   DateTime  @default(now())
}

model WebhookLog {
  id          Int      @id @default(autoincrement())
  webhookId   Int
  event       String
  payload     String   @db.Text
  response    String?  @db.Text
  statusCode  Int?
  success     Boolean
  firedAt     DateTime @default(now())
}

model PaymentTransaction {
  id            Int      @id @default(autoincrement())
  orderId       Int
  businessId    Int
  provider      String   // bkash, nagad, stripe, cash
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("BDT")
  status        String   // pending, success, failed, refunded
  transactionId String?
  sessionId     String?
  metadata      String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Shipment {
  id           Int       @id @default(autoincrement())
  orderId      Int
  businessId   Int
  provider     String    // pathao, steadfast, redx
  trackingId   String?
  status       String    // pending, dispatched, in_transit, delivered, returned
  cost         Decimal?  @db.Decimal(10, 2)
  metadata     String?   @db.Text
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model RegistrationRequest {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(150)
  email        String    @unique @db.VarChar(150)
  phone        String?   @db.VarChar(30)
  gender       String?   @db.VarChar(20)
  dob          DateTime?
  address      String?   @db.Text
  username     String    @db.VarChar(50)
  password     String    @db.VarChar(255)
  status       String    @default("pending") @db.VarChar(20)
  reviewedBy   Int?
  reviewedAt   DateTime?
  rejectReason String?   @db.Text
  createdAt    DateTime  @default(now())
  reviewer     User?     @relation(fields: [reviewedBy], references: [id])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SubscriptionPlan {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(50)
  label       String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  priceMonthly Decimal  @db.Decimal(10, 2)
  priceYearly  Decimal  @db.Decimal(10, 2)
  maxUsers    Int       @default(1)
  maxProducts Int       @default(-1) // -1 = unlimited
  features    String    @db.LongText
  usageLimits String    @db.LongText
  isActive    Boolean   @default(true)
  isTrial     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id            Int       @id @default(autoincrement())
  businessId    Int       @unique
  planId        Int
  status        String    @default("trialing") @db.VarChar(20) // trialing, active, paused, canceled, expired
  billingCycle  String    @default("monthly") @db.VarChar(20) // monthly, yearly
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd   Boolean   @default(false)
  canceledAt    DateTime?
  pausedAt      DateTime?
  resumedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan  @relation(fields: [planId], references: [id])
}

model Usage {
  id            Int      @id @default(autoincrement())
  businessId    Int
  key           String   @db.VarChar(50) // usage key name
  value         Int      @default(0)
  periodStart   DateTime
  periodEnd     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([businessId, key, periodStart])
}

model UsageOverride {
  id          Int      @id @default(autoincrement())
  businessId  Int
  key         String   @db.VarChar(50)
  value       Int      @default(-1) // -1 = unlimited
  reason      String?  @db.VarChar(255)
  createdBy   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([businessId, key])
}

model FeatureFlag {
  id          Int       @id @default(autoincrement())
  key         String    @unique @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  defaultValue Boolean  @default(false)
  createdAt   DateTime  @default(now())
}

model PlatformSetting {
  id            Int       @id @default(autoincrement())
  key           String    @unique @db.VarChar(100)
  value         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model SubscriptionRequest {
  id              Int          @id @default(autoincrement())
  businessId      Int
  userId          Int
  type            String       @db.VarChar(50)
  currentPlan     String?      @db.VarChar(50)
  requestedPlan   String?      @db.VarChar(50)
  reason          String?      @db.VarChar(255)
  message         String?      @db.Text
  status          String       @default("pending") @db.VarChar(20)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id])
  notes           RequestNote[]
}

model RequestNote {
  id          Int       @id @default(autoincrement())
  requestId   Int
  userId      Int
  note        String    @db.Text
  visibility  String    @default("internal") @db.VarChar(20)
  createdAt   DateTime  @default(now())
  request     SubscriptionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])
}

