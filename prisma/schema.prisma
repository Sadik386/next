generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50)
  label       String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(100)
  email     String     @unique @db.VarChar(150)
  password  String     @db.VarChar(255)
  roleId    Int
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  role      Role       @relation(fields: [roleId], references: [id])
  stockLogs StockLog[]
  orders    Order[]    @relation("OrderCreatedBy")
  sales     Sale[]     @relation("SaleCreatedBy")
  expenses  Expense[]  @relation("ExpenseCreatedBy")
  deleteRequestsMade     DeleteRequest[] @relation("DeleteRequestedBy")
  deleteRequestsReviewed DeleteRequest[] @relation("DeleteReviewedBy")
  activityLogs           ActivityLog[]
  posSessions            PosSession[]
  heldOrders             HeldOrder[]
}

model PosSession {
  id            String   @id
  businessId    Int      @default(1)
  createdBy     Int
  status        String   @default("active")
  scans         String?  @db.Text
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  createdByUser User     @relation(fields: [createdBy], references: [id])
}

model HeldOrder {
  id            Int      @id @default(autoincrement())
  businessId    Int      @default(1)
  createdBy     Int
  items         String   @db.Text
  customerData  String?  @db.Text
  discount      Float    @default(0)
  notes         String?
  createdAt     DateTime @default(now())
  createdByUser User     @relation(fields: [createdBy], references: [id])
}

model Category {
  id         Int       @id @default(autoincrement())
  businessId Int       @default(1)
  name       String    @db.VarChar(100)
  createdAt  DateTime  @default(now())
  products   Product[]
  @@unique([businessId, name])
}

model Product {
  id          Int        @id @default(autoincrement())
  productId   String     @unique @db.VarChar(20)
  businessId  Int        @default(1)
  name        String     @db.VarChar(255)
  sku         String?    @db.VarChar(100)
  categoryId  Int?
  unit        String     @db.VarChar(50)
  salePrice   Decimal    @db.Decimal(10, 2)
  costPrice   Decimal    @db.Decimal(10, 2)
  taxRate     Decimal    @default(0) @db.Decimal(5, 2)
  description String?    @db.Text
  imageUrl    String?    @db.VarChar(500)
  status      String     @default("active") @db.VarChar(20)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  category    Category?  @relation(fields: [categoryId], references: [id])
  stock       Stock?
  stockLogs   StockLog[]
  orderItems  OrderItem[]
  sales       Sale[]
}

model Stock {
  id         Int        @id @default(autoincrement())
  businessId Int        @default(1)
  productId  Int        @unique
  quantity   Int        @default(0)
  threshold  Int        @default(10)
  location   String?    @db.VarChar(255)
  updatedAt  DateTime   @updatedAt
  product    Product    @relation(fields: [productId], references: [id])
  stockLogs  StockLog[]
}

model StockLog {
  id            Int      @id @default(autoincrement())
  businessId    Int      @default(1)
  stockId       Int
  productId     Int
  type          String   @db.VarChar(20)
  quantity      Int
  reason        String?  @db.VarChar(255)
  previousQty   Int
  newQty        Int
  createdBy     Int
  createdAt     DateTime @default(now())
  stock         Stock    @relation(fields: [stockId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
  createdByUser User     @relation(fields: [createdBy], references: [id])
}

model DeleteRequest {
  id          Int       @id @default(autoincrement())
  businessId  Int       @default(1)
  entityType  String    @db.VarChar(50)
  entityId    String    @db.VarChar(50)
  entityName  String    @db.VarChar(255)
  reason      String    @db.Text
  status      String    @default("pending") @db.VarChar(20)
  requestedBy Int
  reviewedBy  Int?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  requester   User      @relation("DeleteRequestedBy", fields: [requestedBy], references: [id])
  reviewer    User?     @relation("DeleteReviewedBy", fields: [reviewedBy], references: [id])
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  businessId  Int      @default(1)
  userId      Int
  action      String   @db.VarChar(50)
  module      String   @db.VarChar(50)
  entityId    String?  @db.VarChar(50)
  entityName  String?  @db.VarChar(255)
  description String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Customer {
  id              Int       @id @default(autoincrement())
  customerId      String    @unique @db.VarChar(20)
  businessId      Int       @default(1)
  name            String    @db.VarChar(150)
  email           String?   @db.VarChar(150)
  mobile          String    @db.VarChar(30)
  country         String?   @db.VarChar(100)
  state           String?   @db.VarChar(100)
  zipCode         String?   @db.VarChar(20)
  city            String?   @db.VarChar(100)
  streetAddress   String?   @db.Text
  billingAddress  String?   @db.Text
  shippingAddress String?   @db.Text
  status          String    @default("active") @db.VarChar(20)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  orders          Order[]
  sales           Sale[]
}

model Supplier {
  id              Int       @id @default(autoincrement())
  supplierId      String    @unique @db.VarChar(20)
  businessId      Int       @default(1)
  companyName     String    @db.VarChar(255)
  contactName     String    @db.VarChar(150)
  email           String?   @db.VarChar(150)
  mobile          String?   @db.VarChar(30)
  website         String?   @db.VarChar(255)
  taxId           String?   @db.VarChar(100)
  paymentTerms    String?   @db.VarChar(100)
  currency        String    @default("BDT") @db.VarChar(10)
  bankName        String?   @db.VarChar(150)
  bankAccount     String?   @db.VarChar(100)
  category        String?   @db.VarChar(100)
  deliveryMethod  String?   @db.VarChar(100)
  streetAddress   String?   @db.Text
  city            String?   @db.VarChar(100)
  state           String?   @db.VarChar(100)
  zipCode         String?   @db.VarChar(20)
  country         String?   @db.VarChar(100)
  status          String    @default("active") @db.VarChar(20)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
}

model Setting {
  id            Int      @id @default(autoincrement())
  businessId    Int      @default(1)
  businessName  String   @db.VarChar(150)
  tagline       String?  @db.VarChar(255)
  email         String?  @db.VarChar(150)
  phone         String?  @db.VarChar(30)
  website       String?  @db.VarChar(255)
  taxId         String?  @db.VarChar(100)
  address       String?  @db.Text
  city          String?  @db.VarChar(100)
  state         String?  @db.VarChar(100)
  zipCode       String?  @db.VarChar(20)
  country       String?  @db.VarChar(100)
  logoUrl       String?  @db.VarChar(500)
  printLogoUrl String?  @db.VarChar(500)
  brandColor    String?  @db.VarChar(20)
  invoiceFooter String?  @db.Text
  currency      String   @default("BDT") @db.VarChar(10)
  weekStartDay  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id              Int         @id @default(autoincrement())
  orderId         String      @unique @db.VarChar(20)
  businessId      Int         @default(1)
  customerId      Int
  status          String      @default("pending") @db.VarChar(20)
  paymentStatus   String      @default("unpaid") @db.VarChar(20)
  paymentMethod   String?     @db.VarChar(50)
  subtotal        Decimal     @db.Decimal(10, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal     @db.Decimal(10, 2)
  paidAmount      Decimal     @default(0) @db.Decimal(10, 2)
  shippingAddress String?     @db.Text
  billingAddress  String?     @db.Text
  notes           String?     @db.Text
  createdBy       Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  customer        Customer    @relation(fields: [customerId], references: [id])
  createdByUser   User        @relation("OrderCreatedBy", fields: [createdBy], references: [id])
  items           OrderItem[]
  sales           Sale[]
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  productId   Int
  productName String   @db.VarChar(255)
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  order       Order    @relation(fields: [orderId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
}

model Sale {
  id              Int       @id @default(autoincrement())
  saleId          String    @unique @db.VarChar(20)
  businessId      Int       @default(1)
  orderId         Int?
  customerId      Int?
  productId       Int?
  productName     String?   @db.VarChar(255)
  date            DateTime  @default(now())
  quantity        Int       @default(1)
  unitPrice       Decimal   @db.Decimal(10, 2)
  totalAmount     Decimal   @db.Decimal(10, 2)
  taxAmount       Decimal   @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal   @default(0) @db.Decimal(10, 2)
  paymentStatus   String    @default("unpaid") @db.VarChar(20)
  paymentMethod   String?   @db.VarChar(50)
  shippingAddress String?   @db.Text
  billingAddress  String?   @db.Text
  deliveryDate    DateTime?
  trackingNumber  String?   @db.VarChar(100)
  warrantyPeriod  String?   @db.VarChar(100)
  salesCommission Decimal   @default(0) @db.Decimal(10, 2)
  returnStatus    String    @default("none") @db.VarChar(20)
  notes           String?   @db.Text
  createdBy       Int
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  order           Order?    @relation(fields: [orderId], references: [id])
  customer        Customer? @relation(fields: [customerId], references: [id])
  product         Product?  @relation(fields: [productId], references: [id])
  createdByUser   User      @relation("SaleCreatedBy", fields: [createdBy], references: [id])
}

model Expense {
  id            Int       @id @default(autoincrement())
  expenseId     String    @unique @db.VarChar(20)
  businessId    Int       @default(1)
  date          DateTime  @default(now())
  amount        Decimal   @db.Decimal(10, 2)
  currency      String    @default("BDT") @db.VarChar(10)
  category      String    @db.VarChar(100)
  paymentMethod String    @db.VarChar(50)
  vendor        String    @db.VarChar(255)
  receiptId     String?   @db.VarChar(100)
  referenceNo   String?   @db.VarChar(100)
  taxAmount     Decimal   @default(0) @db.Decimal(10, 2)
  taxPercent    Decimal   @default(0) @db.Decimal(5, 2)
  description   String?   @db.Text
  notes         String?   @db.Text
  createdBy     Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdByUser User      @relation("ExpenseCreatedBy", fields: [createdBy], references: [id])
}
