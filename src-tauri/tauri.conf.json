{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "distDir": "../out"
  },
  "package": {
    "productName": "Acuity Commerce",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "identifier": "com.acuitycommerce.app"
    },
    "window": [
      {
        "title": "Acuity Commerce",
        "width": 1200,
        "height": 800
      }
    ]
  }
}
