# Database
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"

# App
NEXT_PUBLIC_APP_NAME="Accoraze"
NEXT_PUBLIC_APP_URL="https://app.accoraze.com"
APP_MODE="cloud"
APP_SETUP_REQUIRED="true"
APP_LICENSE_REQUIRED="false"
APP_UPDATES_ENABLED="false"
NODE_ENV="production"

# Auth
# JWT_SECRET: Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="GENERATE-A-STRONG-RANDOM-STRING-HERE-MIN-64-CHARS"

# Encryption (AES-256-GCM for SMTP passwords in DB)
# ENCRYPTION_KEY: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="GENERATE-A-32-BYTE-RANDOM-HEX-KEY-HERE"

# CAPTCHA / Turnstile (Cloudflare dashboard: https://dash.cloudflare.com/)
# Site key goes in frontend (NEXT_PUBLIC_TURNSTILE_SITE_KEY)
# Secret key goes here (TURNSTILE_SECRET_KEY)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="YOUR-TURNSTILE-SITE-KEY"
TURNSTILE_SECRET_KEY="YOUR-TURNSTILE-SECRET-KEY"

# SMTP / Email
# Used for: password reset, email verification, platform notifications
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
SMTP_FROM_EMAIL="noreply@accoraze.com"
SMTP_FROM_NAME="Accoraze Platform"
SMTP_REPLY_TO="support@accoraze.com"